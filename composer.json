{
    "name": "loz/exme",
    "description": "extended markup expressions",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "EXME\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EXME\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "xdebug": "XDEBUG_MODE=debug XDEBUG_TRIGGER=1 XDEBUG_CONFIG=\"idekey=XDEBUG_VSCODE\" php vendor/bin/phpunit --filter LexerIntegrationTest"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    }
}
